<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Light). -->
    <style name="Base.Theme.TrackFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/tf_primary</item>
        <item name="colorPrimaryVariant">@color/tf_primary_variant</item>
        <item name="colorOnPrimary">@color/tf_on_primary</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/tf_secondary</item>
        <item name="colorSecondaryVariant">@color/tf_secondary_variant</item>
        <item name="colorOnSecondary">@color/tf_on_secondary</item>
        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/tf_background</item>
        <item name="colorSurface">@color/tf_surface</item>
        <item name="colorOnBackground">@color/tf_on_background</item>
        <item name="colorOnSurface">@color/tf_on_surface</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/tf_primary</item>
    </style>

    <style name="Theme.TrackFlow" parent="Base.Theme.TrackFlow" />
</resources>