<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tambah Aktivitas"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/edtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Judul (misal: Lari Pagi)"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/edtDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Jarak (misal: 5)"
            android:inputType="numberDecimal"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:id="@+id/layoutQuickDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:padding="14dp"
            android:background="?attr/colorSurfaceVariant">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Durasi Latihan (Klik angka untuk input presisi)"
                android:textSize="11sp"
                android:textStyle="italic"
                android:textColor="?attr/colorOnSurfaceVariant"/>

            <TextView
                android:id="@+id/tvDurationDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 Menit"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/strava_orange"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:weightSum="4">
                <Button android:id="@+id/btnPlus5" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="2dp" android:text="+5m" android:textSize="11sp"/>
                <Button android:id="@+id/btnPlus10" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="2dp" android:text="+10m" android:textSize="11sp"/>
                <Button android:id="@+id/btnPlus15" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="2dp" android:text="+15m" android:textSize="11sp"/>
                <Button android:id="@+id/btnPlus30" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="2dp" android:text="+30m" android:textSize="11sp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnResetDuration"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Reset Waktu"
                android:textSize="11sp"/>
        </LinearLayout>

        <EditText
            android:id="@+id/edtDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Durasi"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/edtDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tanggal (Klik untuk pilih)"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/strava_orange"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:text="Simpan Aktivitas" />

    </LinearLayout>
</ScrollView>