<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Top Toolbar Header -->
    <LinearLayout
        android:id="@+id/llToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/colorSurface"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_down"
            android:rotation="90"
            app:tint="?attr/colorOnSurface"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Simpan Aktivitas"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="24dp" />
    </LinearLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/llToolbar"
        app:layout_constraintBottom_toTopOf="@id/btnSave">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title Input Box -->
            <EditText
                android:id="@+id/edtTitle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Beri judul berlari Anda"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="@color/app_text_hint"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:inputType="textPersonName"
                android:layout_marginBottom="12dp" />

            <!-- Description / Share Thoughts Box -->
            <EditText
                android:id="@+id/edtDescription"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="Bagaimana hasilnya? Ceritakan lebih banyak tentang aktivitas Anda dan gunakan @ untuk menandai seseorang."
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="@color/app_text_hint"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:textSize="12sp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:layout_marginBottom="12dp" />

            <!-- Distance & Date Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Distance Input Box -->
                <EditText
                    android:id="@+id/edtDistance"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="Jarak (contoh: 5)"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="@color/app_text_hint"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    android:inputType="numberDecimal"
                    android:layout_marginEnd="6dp" />

                <!-- Date Input Box -->
                <EditText
                    android:id="@+id/edtDate"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="Tanggal (Klik untuk pilih)"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="@color/app_text_hint"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    android:focusable="false"
                    android:clickable="true"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Duration Input Box (Hidden by default unless coming from Record stopwatch) -->
            <EditText
                android:id="@+id/edtDuration"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Durasi"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="@color/app_text_hint"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <!-- Quick Duration Selection Card (Visible only when manually adding) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardQuickDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/app_surface_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Durasi Latihan (Klik angka untuk input presisi)"
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvDurationDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0 Menit"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FC4C02"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginTop="4dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:weightSum="4">
                        <Button android:id="@+id/btnPlus5" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="+5m" android:textColor="?attr/colorOnSurface" android:textSize="11sp"/>
                        <Button android:id="@+id/btnPlus10" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="+10m" android:textColor="?attr/colorOnSurface" android:textSize="11sp"/>
                        <Button android:id="@+id/btnPlus15" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="+15m" android:textColor="?attr/colorOnSurface" android:textSize="11sp"/>
                        <Button android:id="@+id/btnPlus30" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="+30m" android:textColor="?attr/colorOnSurface" android:textSize="11sp"/>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnResetDuration"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="Reset Waktu"
                        android:textColor="#FF4D4D"
                        android:textSize="11sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Sport Dropdown Selector (Berlari) -->
            <LinearLayout
                android:id="@+id/llSportSelector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/ivFormSportIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_shoe"
                    app:tint="?attr/colorOnSurface" />
                <TextView
                    android:id="@+id/tvFormSportName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Berlari"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginStart="12dp"
                    android:textSize="14sp" />
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Map and Media cards Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="12dp">

                <!-- Left card: Sample Map Preview -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <!-- Tiny mock map / background view -->
                        <org.osmdroid.views.MapView
                            android:id="@+id/mapViewPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                        <!-- Subtle bottom info overlay (no longer blocks map) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:background="#99000000"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="6dp">
                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@android:drawable/ic_dialog_info"
                                app:tint="#FFFFFF"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Peta rute aktivitas Anda"
                                android:textColor="#FFFFFF"
                                android:textSize="8sp"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Right card: Add Photo/Video dashed card -->
                <LinearLayout
                    android:id="@+id/llAddPhoto"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_dashed_border"
                    android:clickable="true"
                    android:focusable="true">
                    
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_gallery"
                                app:tint="#FC4C02" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tambahkan Foto/Video"
                                android:textColor="#FC4C02"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
    
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@android:color/transparent">
                            <ImageView
                                android:id="@+id/ivPreviewPhoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:visibility="gone" />
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Ubah Tipe Peta Button -->
            <Button
                android:id="@+id/btnChangeMapType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Ubah Tipe Peta"
                android:textColor="#FC4C02"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_outline_orange_btn"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_marginBottom="24dp" />

            <!-- Details Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rincian"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Detail dropdown: Tag Aktivitas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="10dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_route"
                    app:tint="?attr/colorOnSurfaceVariant" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tag Aktivitas"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginStart="12dp"
                    android:textSize="14sp" />
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Detail dropdown: Bagaimana rasanya... -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="10dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_heartbeat"
                    app:tint="?attr/colorOnSurfaceVariant" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bagaimana rasanya aktivitas terse..."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginStart="12dp"
                    android:textSize="14sp" />
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Detail dropdown: Catat catatan pribadi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="10dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lock"
                    app:tint="?attr/colorOnSurfaceVariant" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Catat catatan pribadi di sini..."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginStart="12dp"
                    android:textSize="14sp" />
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Detail row: Tambahkan perlengkapan baru -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="24dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_shoe"
                    app:tint="?attr/colorOnSurfaceVariant" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tambahkan perlengkapan baru!"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginStart="12dp"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Visibility Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Visibilitas"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Visibility dropdown: Siapa yang bisa melihat -->
            <LinearLayout
                android:id="@+id/llVisibility"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_broadcast"
                    app:tint="?attr/colorOnSurfaceVariant" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Siapa yang bisa melihat"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvVisibility"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Para pengikut"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Visibility dropdown: Detail Tersembunyi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="24dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lock"
                    app:tint="?attr/colorOnSurfaceVariant" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Detail Tersembunyi"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pilih"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Mute Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Senyapkan Aktivitas"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Checkbox Option -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="36dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jangan publikasikan ke feed Home atau Klub"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aktivitas ini akan tetap terlihat di profil Anda"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <CheckBox
                    android:id="@+id/cbMuteActivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Buang Aktivitas Discard Button -->
            <Button
                android:id="@+id/btnDiscard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Buang Aktivitas"
                android:textColor="#FF4D4D"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_outline_red_btn"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Save Activity Bottom Orange Button -->
    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="Simpan Aktivitas"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"
        app:backgroundTint="#FC4C02"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>