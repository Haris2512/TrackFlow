<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical">

    <!-- Content Row (Flame on Left, Calendar Strip on Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left Side: Flame Block -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="16dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_flame"
                    app:tint="#FC4C02"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minggu"
                android:textColor="#FC4C02"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Right Side: Calendar Strip (S S R K J S M) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="7">

            <!-- Day 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvDayName1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S"
                    android:textColor="@color/circle_other_text"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
                <FrameLayout
                    android:id="@+id/flDateFrame1"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_dark"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/tvDateVal1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="1"
                        android:textColor="@color/circle_other_text"
                        android:textSize="11sp"
                        android:gravity="center"/>
                    <ImageView
                        android:id="@+id/ivShoeIcon1"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shoe"
                        app:tint="@color/circle_shoe_tint"
                        android:visibility="gone"/>
                </FrameLayout>
            </LinearLayout>

            <!-- Day 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvDayName2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S"
                    android:textColor="@color/circle_other_text"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
                <FrameLayout
                    android:id="@+id/flDateFrame2"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_dark"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/tvDateVal2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="2"
                        android:textColor="@color/circle_other_text"
                        android:textSize="11sp"
                        android:gravity="center"/>
                    <ImageView
                        android:id="@+id/ivShoeIcon2"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shoe"
                        app:tint="@color/circle_shoe_tint"
                        android:visibility="gone"/>
                </FrameLayout>
            </LinearLayout>

            <!-- Day 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvDayName3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R"
                    android:textColor="@color/circle_other_text"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
                <FrameLayout
                    android:id="@+id/flDateFrame3"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_dark"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/tvDateVal3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="3"
                        android:textColor="@color/circle_other_text"
                        android:textSize="11sp"
                        android:gravity="center"/>
                    <ImageView
                        android:id="@+id/ivShoeIcon3"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shoe"
                        app:tint="@color/circle_shoe_tint"
                        android:visibility="gone"/>
                </FrameLayout>
            </LinearLayout>

            <!-- Day 4 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvDayName4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="K"
                    android:textColor="@color/circle_other_text"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
                <FrameLayout
                    android:id="@+id/flDateFrame4"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_dark"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/tvDateVal4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="4"
                        android:textColor="@color/circle_other_text"
                        android:textSize="11sp"
                        android:gravity="center"/>
                    <ImageView
                        android:id="@+id/ivShoeIcon4"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shoe"
                        app:tint="@color/circle_shoe_tint"
                        android:visibility="gone"/>
                </FrameLayout>
            </LinearLayout>

            <!-- Day 5 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvDayName5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="J"
                    android:textColor="@color/circle_other_text"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
                <FrameLayout
                    android:id="@+id/flDateFrame5"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_dark"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/tvDateVal5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="5"
                        android:textColor="@color/circle_other_text"
                        android:textSize="11sp"
                        android:gravity="center"/>
                    <ImageView
                        android:id="@+id/ivShoeIcon5"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shoe"
                        app:tint="@color/circle_shoe_tint"
                        android:visibility="gone"/>
                </FrameLayout>
            </LinearLayout>

            <!-- Day 6 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvDayName6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S"
                    android:textColor="@color/circle_other_text"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
                <FrameLayout
                    android:id="@+id/flDateFrame6"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_dark"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/tvDateVal6"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="6"
                        android:textColor="@color/circle_other_text"
                        android:textSize="11sp"
                        android:gravity="center"/>
                    <ImageView
                        android:id="@+id/ivShoeIcon6"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shoe"
                        app:tint="@color/circle_shoe_tint"
                        android:visibility="gone"/>
                </FrameLayout>
            </LinearLayout>

            <!-- Day 7 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvDayName7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="M"
                    android:textColor="@color/circle_other_text"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
                <FrameLayout
                    android:id="@+id/flDateFrame7"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_dark"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/tvDateVal7"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="7"
                        android:textColor="@color/circle_other_text"
                        android:textSize="11sp"
                        android:gravity="center"/>
                    <ImageView
                        android:id="@+id/ivShoeIcon7"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shoe"
                        app:tint="@color/circle_shoe_tint"
                        android:visibility="gone"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Legend Explanation Text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="* Ikon sepatu menunjukkan penanda hari ini secara real time."
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="10sp"
        android:layout_marginTop="12dp"
        android:gravity="center_horizontal" />
</LinearLayout>
